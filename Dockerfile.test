# Day 6 — run Maven tests in a reproducible image (slides: Temurin JDK 21 Alpine).
# Bytecode stays Java 17 for participant JDK compatibility; JVM 21 runs it fine.
FROM eclipse-temurin:21-jdk-alpine

RUN apk add --no-cache bash

WORKDIR /app

COPY mvnw .
COPY .mvn .mvn
COPY pom.xml .
RUN chmod +x mvnw && ./mvnw dependency:go-offline -B --no-transfer-progress

COPY src src

# Align with CI unit job + JDBC against Compose Postgres (skip @Tag("integration") here).
CMD ["./mvnw", "test", "-B", "--no-transfer-progress", "-DexcludedGroups=integration"]
